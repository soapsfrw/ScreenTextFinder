<Window x:Class="ScreenTextFinder.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Screen Text Finder"
        Height="150"
        Width="420"
        WindowStartupLocation="Manual"
        Top="0">
    <StackPanel Margin="10">
        <TextBlock Text="Keywords (comma separated):"/>
        <TextBox x:Name="KeywordBox" Margin="0,5,0,10" KeyDown="KeywordBox_KeyDown"/>
        <Button Content="Scan Screen"
                Height="32"
                Click="Scan_Click"/>
    </StackPanel>
</Window>
